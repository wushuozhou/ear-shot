{
  "name": "earshot-desktop",
  "version": "0.12.0",
  "private": true,
  "description": "听屿 · 聊天、语音与记忆",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.wushuozhou.earshot",
    "productName": "听屿",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "config.cjs",
      "providers.cjs",
      "provider-test.cjs",
      "agent.cjs",
      "loading.html",
      "app/**/*",
      "skills/**/*",
      "archive-protocol.cjs"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "earshot/server"
      },
      {
        "from": "../web",
        "to": "earshot/web"
      },
      {
        "from": "../persona.example.md",
        "to": "earshot/persona.example.md"
      },
      {
        "from": "../persona.example.zh.md",
        "to": "earshot/persona.example.zh.md"
      },
      {
        "from": "../package.json",
        "to": "earshot/package.json"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Tingyu-Setup-${version}.${ext}",
      "signAndEditExecutable": true,
      "icon": "app/brand/tingyu.ico",
      "signExecutable": false
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "听屿"
    },
    "executableName": "Tingyu"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.12"
  }
}
