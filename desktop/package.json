{
  "name": "earshot-desktop",
  "version": "0.3.1",
  "private": true,
  "description": "Electron desktop shell for Earshot",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.wushuozhou.earshot",
    "productName": "Earshot",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "config.cjs",
      "providers.cjs",
      "provider-test.cjs",
      "agent.cjs",
      "loading.html",
      "app/**/*",
      "skills/**/*"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "earshot/server"
      },
      {
        "from": "../web",
        "to": "earshot/web"
      },
      {
        "from": "../persona.example.md",
        "to": "earshot/persona.example.md"
      },
      {
        "from": "../persona.example.zh.md",
        "to": "earshot/persona.example.zh.md"
      },
      {
        "from": "../package.json",
        "to": "earshot/package.json"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Earshot-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Earshot 听着呢"
    }
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.12"
  }
}
